# ─── The Wedding Invite Co. · copy this file to .env and fill it in ───

# Website address (no https://, no slash). Point its DNS A record at the VPS first.
DOMAIN=weddinginvite.kavitha.cloud
SITE_URL=https://weddinginvite.kavitha.cloud

# Lead dashboard at /admin
ADMIN_PASSWORD=choose-a-long-password
# SESSION_SECRET is added by the setup command in the README (openssl rand -base64 32)

# The WhatsApp number couples chat with on the site (country code, digits only)
PUBLIC_WHATSAPP=919747351013

# ─── Email alert for every enquiry ───
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kevinvarghese333@gmail.com
SMTP_PASS=
MAIL_FROM="The Wedding Invite Co. <kevinvarghese333@gmail.com>"
# Where alerts go (comma-separate for more than one)
NOTIFY_EMAIL=kevinvarghese333@gmail.com

# ─── WhatsApp alert for every enquiry ───
# The number that receives alerts (country code, digits only)
NOTIFY_WHATSAPP=919747351013
# callmebot (free, quickest), waha (your own number, extra container), webhook, or none
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_API_KEY=

# Only if WHATSAPP_PROVIDER=waha
WAHA_URL=http://wedding-invite-waha:3000
WAHA_API_KEY=change-me
WAHA_SESSION=default

# Only if WHATSAPP_PROVIDER=webhook (e.g. your own Hermes relay). Receives {"to","text"} as JSON.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
